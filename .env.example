# LLM analysis endpoint
ANALYSIS_API_KEY=your_api_key_here
ANALYSIS_BASE_URL=https://your-llm-endpoint.example.com/v1
ANALYSIS_MODEL=your_model_name

# Feishu / Lark bot
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id
FEISHU_SECRET=your_webhook_secret

# Optional collector tuning
BAIDU_SEARCH_TIMEOUT_MS=30000
BAIDU_SEARCH_MAX_ATTEMPTS=2
BAIDU_SEARCH_RETRY_DELAY_MS=1500
BAIDU_SEARCH_REQUEST_DELAY_MS=1500
BAIDU_SEARCH_REQUEST_JITTER_MS=1500
BAIDU_SEARCH_MAX_ITEMS=10
BAIDU_SEARCH_MAX_AGE_DAYS=7
BAIDU_SEARCH_BATCH_DELAY_MS=600000
